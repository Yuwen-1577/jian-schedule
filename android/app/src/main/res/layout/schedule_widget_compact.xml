<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_compact_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_compact_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/widget_compact_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#999999"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_compact_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:singleLine="true"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/widget_compact_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#666666"
                android:singleLine="true"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/widget_compact_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#666666"
                android:singleLine="true" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_compact_progress_container"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <View
                android:id="@+id/widget_compact_progress_bg"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <View
                android:id="@+id/widget_compact_progress_fg"
                android:layout_width="0dp"
                android:layout_height="48dp" />

        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/widget_compact_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="暂无课程"
        android:textSize="14sp"
        android:textColor="#999999"
        android:visibility="gone" />

</RelativeLayout>
